<h2>hpclint — check a job script</h2>

<% if @error %>
  <p style="color: red;"><%= @error %></p>
<% end %>

<form method="post" action="/check">
  <label for="script_path">Path to your Slurm job script:</label><br>
  <input type="text" id="script_path" name="script_path" size="60"
         placeholder="/home/you/myjob.sh" required><br><br>
  <button type="submit">Check script</button>
</form>
